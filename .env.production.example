ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

ConnectionStrings__LoafNCattingMobile=Server=mascoteach-mssql,1433;Database=LoafNCattingMobile;User Id=example_sql_user;Password=not-a-real-password;Encrypt=True;TrustServerCertificate=True

PayOS__ClientId=not-a-real-client-id
PayOS__ApiKey=not-a-real-api-key
PayOS__ChecksumKey=not-a-real-checksum-key

Payments__PendingPaymentExpirySeconds=300

S3__BucketName=example-bucket-name
S3__Region=ap-southeast-1
S3__UploadUrlExpiresInMinutes=10
S3__DownloadUrlExpiresInMinutes=60
S3__AccessKey=not-a-real-access-key
S3__SecretKey=not-a-real-secret-key
S3__SessionToken=

Mail__Smtp__Host=smtp.example.com
Mail__Smtp__Port=587
Mail__Smtp__EnableSsl=true
Mail__Smtp__Username=example-smtp-user
Mail__Smtp__Password=not-a-real-password
Mail__Smtp__FromEmail=noreply@example.com
Mail__Smtp__FromName=LoafNCatting

Auth__EmailVerification__OtpLength=6
Auth__EmailVerification__ExpiresInMinutes=10
SessionTokens__ExpiresInHours=12

# Optional only after real redirect handling exists:
# PayOS__ReturnUrl=https://loaf-api.mascoteach.com/api/payments/return
# PayOS__CancelUrl=https://loaf-api.mascoteach.com/api/payments/cancel
